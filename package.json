{
  "name": "scrim",
  "productName": "Scrim",
  "version": "0.4.3",
  "description": "Record, frame and polish screen demos",
  "author": "AOB",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "release": "electron-vite build && electron-builder --win --x64 --publish always",
    "build:web": "node -e \"require('fs').rmSync('server/feedback/public/app/assets',{recursive:true,force:true})\" && vite build --config vite.web.config.ts && node -e \"require('fs').renameSync('server/feedback/public/app/web.html','server/feedback/public/app/index.html')\"",
    "perf": "node tools/perf-player.mjs"
  },
  "dependencies": {
    "@sentry/electron": "^7.20.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "iconsax-react": "^0.0.8",
    "mediabunny": "^1.59.0",
    "onnxruntime-web": "^1.22.0-dev.20250409-89f8206ba4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alphred-OB/Scrim.git"
  }
}
